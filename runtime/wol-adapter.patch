+/* Map the section file itself over the caller's buffer, no sidecar copy.
+ * Requires source and destination to agree on their page offset, so the file page and the guest page
+ * can be aligned by the same small lead; otherwise returns 0 and the caller falls back. */
+static int wol_romfs_map_source(int source,uint64_t file_offset,uint8_t *dest,uint64_t size,
+                                struct wol_romfs_cow_result *out) {
+    if(!out)return 0;
+    *out=(struct wol_romfs_cow_result){0};
+    const uint64_t page=(uint64_t)sysconf(_SC_PAGESIZE);
+    uint64_t address=(uintptr_t)dest;
+    if(!size || !dest || file_offset%page!=address%page)return 0;
+    uint64_t lead=(page-file_offset%page)%page;
+    if(lead>=size)return 0;
+    uint64_t span=(size-lead)&~(page-1);
+    if(!span)return 0;
+    uint64_t tail=size-lead-span;
+    if(lead) {
+        ssize_t got=pread(source,dest,(size_t)lead,(off_t)file_offset);
+        if(got!=(ssize_t)lead)return 0;
+    }
+    void *mapped=mmap((void *)(uintptr_t)(address+lead),(size_t)span,
+                      PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_FIXED,source,(off_t)(file_offset+lead));
+    if(mapped==MAP_FAILED || (uintptr_t)mapped!=address+lead){out->error=errno;return -1;}
+    if(tail) {
+        ssize_t got=pread(source,dest+lead+span,(size_t)tail,(off_t)(file_offset+lead+span));
+        if(got!=(ssize_t)tail) {
+            /* The interior is already committed; a short edge read leaves the caller a hole, so fail
+             * loudly instead of pretending the range is complete. */
+            out->address=address+lead;out->mapped=span;out->error=EIO;return -1;
+        }
