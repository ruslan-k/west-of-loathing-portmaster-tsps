+#include "aw_release.h"
+/* One asynchronous EXT_disjoint_timer_query, sampled every 120 frames.
+ * No waits, no result query before availability; context mismatch disables
+ * observation without touching a foreign-context name. Not a fast path. */
+struct wol_gpu_timer {
+    void (*gen)(GLsizei,GLuint *);void (*del)(GLsizei,const GLuint *);
+    void (*begin)(GLenum,GLuint);void (*end)(GLenum);
+    void (*get)(GLuint,GLenum,GLuint *);void (*get64)(GLuint,GLenum,uint64_t *);
+    void (*integer)(GLenum,GLint *);
+    GLuint query;unsigned active,pending,disabled,frame,op,draws,width,height,shots,discarded;
+    uintptr_t context;
+};
+static unsigned wol_gpu_timer_enabled(void) {
+    static int configured;static unsigned on;
+    if(!configured){const char *o=getenv("WOL_GPU_TIMELINE");on=o&&!strcmp(o,"1");configured=1;}
+    return on;
+}
+static unsigned wol_gpu_timer_poll(struct wol_gpu_timer *t,uintptr_t context) {
+    if(!t->pending || t->active || t->disabled)return 0;
+    if(context!=t->context){t->disabled=1;return 0;}
+    GLuint ready=0;t->get(t->query,0x8867,&ready);
+    if(!ready)return 0;
+    GLint disjoint=0;t->integer(0x8fbb,&disjoint);
+    uint64_t ns=0;t->get64(t->query,0x8866,&ns);
+    if(disjoint)t->discarded++;
+    else diag_printf("WOL_GPU_TIMELINE frame=%u op=%u draws=%u logical=%ux%u gpu_ns=%llu context=%p asynchronous=1\n",
+        t->frame,t->op,t->draws,t->width,t->height,(unsigned long long)ns,(void *)context);
+    t->del(1,&t->query);t->query=0;t->pending=0;
+    return 1;
+}
+static unsigned wol_gpu_timer_begin(struct wol_gpu_timer *t,unsigned frame,unsigned op,
+                                    unsigned draws,unsigned width,unsigned height,uintptr_t context) {
+    if(t->disabled || t->pending || t->active || !context || frame%120 || t->shots>=64)return 0;
+    if(t->context && context!=t->context){t->disabled=1;return 0;}
+    if(!t->gen || !t->del || !t->begin || !t->end || !t->get || !t->get64 || !t->integer)return 0;
+    t->context=context;t->frame=frame;t->op=op;t->draws=draws;t->width=width;t->height=height;
+    t->gen(1,&t->query);
+    if(!t->query){t->disabled=1;return 0;}
+    GLint disjoint=0;t->integer(0x8fbb,&disjoint);
+    if(disjoint){t->del(1,&t->query);t->query=0;t->discarded++;return 0;}
+    t->begin(0x88bf,t->query);t->active=1;t->shots++;
+    return 1;
+}
+static void wol_gpu_timer_end(struct wol_gpu_timer *t) {
+    if(!t->active)return;
+    t->end(0x88bf);t->active=0;t->pending=1;
+}
