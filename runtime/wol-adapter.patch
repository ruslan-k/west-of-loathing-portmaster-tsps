+    const char *o=getenv("WOL_UNIFORM_CACHE"),*c=getenv("WOL_UNIFORM_CENSUS");
+    wol_uniform_state.enabled=o&&!strcmp(o,"1");
+    wol_uniform_state.census=c&&!strcmp(c,"1");
+    wol_uniform_state.generation=1;
+    if(wol_uniform_state.enabled||wol_uniform_state.census)
+        diag_printf("WOL_UNIFORM_MODE cache=%u census=%u banks=2 floats=96 identity=linked-program+location+bytes context-switch=invalidate-all default=off\n",
