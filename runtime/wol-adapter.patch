+/* Read-only walker over the current call's guest stack. Reader failure,
+ * misalignment, cyclic/backward links and >1 MiB extent terminate observation.
+ * No speculative stack scan, arbitrary dereference, mprotect or guest writes. */
+static unsigned wol_rt_origin_frames(uint64_t fp,uint64_t sp,uint64_t *out,unsigned capacity,
+                                     int (*reader)(void *,uint64_t,uint64_t[2]),void *opaque) {
+    unsigned count=0;
+    if(!out || !reader)return 0;
+    if(capacity>8)capacity=8;
+    while(count<capacity && fp>=sp && fp-sp<=0xffff0 && !(fp&15)) {
+        uint64_t pair[2];
+        if(!reader(opaque,fp,pair))break;
+        out[count++]=pair[1];
+        if(pair[0]<=fp)break;
+        fp=pair[0];
+    }
+    return count;
+}
