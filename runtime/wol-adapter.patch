+    {0x13965a0U, 0x94156978U, 1U, 0U},    /* camera-target build */
+    {0x13963e8U, 0xb9006260U, 3U, 0x60U}, /* Screen width result */
+    {0x13963fcU, 0xb9006660U, 3U, 0x64U}, /* Screen height result */
