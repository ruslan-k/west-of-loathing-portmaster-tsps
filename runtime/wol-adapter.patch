+/* SDL's KMSDRM backend recreates its EGL surface when it swaps. A cached EGLSurface then still
+ * answers eglQuerySurface but eglMakeCurrent returns EGL_BAD_SURFACE (measured on TSPS: first present
+ * fine, second present NVN_PRESENT_CONTEXT/0x300d). Ask SDL to restore its own binding for this
+ * context and reuse whatever surface it made current instead of the stale handle. */
+static EGLSurface nvn_platform_live_surface(EGLSurface cached) {
+    if(!nvn_platform_sdl_window || !nvn_platform_sdl_context)return cached;
+    SDL_ClearError();
+    /* SDL's own context, not eglGetCurrentContext(): the runtime detaches between operations, so the
+     * thread usually has no current context and SDL would be asked to bind nothing. */
+    if(SDL_GL_MakeCurrent(nvn_platform_sdl_window,nvn_platform_sdl_context))return cached;
+    EGLSurface live=eglGetCurrentSurface(EGL_DRAW);
+    return live!=EGL_NO_SURFACE?live:cached;
+}
