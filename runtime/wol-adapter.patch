+        if(owner > UINT64_MAX - 40 || wol_up24_mem < 0) stop("WOL_UP24_OWNER_UNREADABLE", pc, owner, 24);
+        if(!accessible(owner + 32, 8, PROT_READ)) stop("WOL_UP24_OWNER_UNREADABLE", pc, owner, 24);
+        if(pread(wol_up24_mem, pair, 8, (off_t)(owner + 32)) != 8) stop("WOL_UP24_OWNER_UNREADABLE", pc, owner, 24);
+        before[0] = pair[0]; before[1] = pair[1];
+        if(wol_up24_patch && pair[0] == WOL_UP24_WIDTH && pair[1] == WOL_UP24_HEIGHT) {
+            pair[0] = WOL_UP24_TARGET_WIDTH;
+            pair[1] = WOL_UP24_TARGET_HEIGHT;
+        }
+        r[8] = pair[0];
+        r[9] = pair[1];
+        ctx->uc_mcontext.pc = pc + 4;
+        if(wol_up24_events < 4 && wol_up24_mem >= 0 && accessible(owner + 0x78, 0x80, PROT_READ)) {
+            /* owner[0..0x7f]: look for the force-pixel pair before touching anything. */
+            uint32_t words[32];
+            if(pread(wol_up24_mem, words, sizeof words, (off_t)owner) == (ssize_t)sizeof words) {
+                printf("WOL_UPRENDER24_LAYOUT owner=0x%llx", (unsigned long long)owner);
+                for(unsigned k = 0; k < 32; k++) printf(" %u", words[k]);
+                printf("\n");
+            }
+        }
+        if(wol_up24_events++ < 64)
+            printf("WOL_UPRENDER24 site=aspect owner=0x%llx loaded=%ux%u used=%ux%u written=%u\n",
+                   (unsigned long long)owner, before[0], before[1], pair[0], pair[1],
+                   (unsigned)(before[0] != pair[0] || before[1] != pair[1]));
+        return 1;
+    }
+    /* Screen width/height result: the original instruction stores w0 into owner+field. */
+    unsigned field = wol_up24_sites[action - 1].field;
+    uint32_t value = (uint32_t)r[0], before = value;
+    if(wol_up24_patch) {
+        if(action == 3 && value == WOL_UP24_WIDTH) value = WOL_UP24_TARGET_WIDTH;
+        if(action == 4 && value == WOL_UP24_HEIGHT) value = WOL_UP24_TARGET_HEIGHT;
+    }
+    r[0] = value;
+    if(owner > UINT64_MAX - 0x80 || !accessible(owner + field, 4, PROT_READ | PROT_WRITE))
+        stop("WOL_UP24_STORE_TARGET", pc, owner, 24);
+    memcpy((void *)(uintptr_t)(owner + field), &value, 4);
+    ctx->uc_mcontext.pc = pc + 4;
+    if(wol_up24_events++ < 64)
+        printf("WOL_UPRENDER24 site=%s owner=0x%llx screen=%u used=%u\n",
+               action == 4 ? "height" : "width", (unsigned long long)owner, before, value);
+    return 1;
+}
