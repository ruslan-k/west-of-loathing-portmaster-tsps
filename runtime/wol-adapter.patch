+       offset>INT64_MAX || size>(uint64_t)INT64_MAX-offset || fstat(source,&st) ||
+       !S_ISREG(st.st_mode) || st.st_size<0 || offset>(uint64_t)st.st_size ||
+       size>(uint64_t)st.st_size-offset || !directory)return 0;
