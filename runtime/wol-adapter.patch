+    glBindAttribLocation(pr,0,"p");glLinkProgram(pr);glGetProgramiv(pr,GL_LINK_STATUS,&ok);
+    if(!ok){log[0]=0;glGetProgramInfoLog(pr,sizeof log,NULL,log);diag_printf("WOL_BLIT_REALIZE stage=link ok=0 log=%s\n",log);return 0;}
+    wol_blit_program=pr;wol_blit_tex=glGetUniformLocation(pr,"tex");
+    diag_printf("WOL_BLIT_REALIZE ok=1 program=%u tex=%d\n",(unsigned)pr,(int)wol_blit_tex);
+    return 1;
+}
+/* Region blit for the per-frame 1:1 colour copy (nvnCommandBufferCopyTextureToTexture):
+ * the CPU path memcpy'ed 3.69 MB per frame and then re-uploaded the same bytes through
+ * zero_texture_refresh (measured 2026-10-15: 2560 copies + 2560 full-texture uploads in one
+ * ~134 s run). The blit reads the source GL texture and writes the destination region
+ * directly. Same shader pair as the resolve blit, with explicit per-corner UVs and a
+ * texel-centre offset for an exact 1:1 mapping; WOL_COPY_GPU_FLIP=1 flips the V mapping
+ * for the empirical orientation A/B. WOL_COPY_GPU=1 selects it; default stays the CPU copy. */
+static GLuint wol_rblit_program;static GLint wol_rblit_tex=-1;
+static unsigned wol_rblit_realize(void) {
+    if(wol_rblit_program)return 1;
+    static const char *vs="attribute vec2 p;attribute vec2 t;varying vec2 uv;void main(){uv=t;gl_Position=vec4(p,0.0,1.0);}\n";
+    static const char *fs="precision mediump float;varying vec2 uv;uniform sampler2D tex;void main(){gl_FragColor=texture2D(tex,uv);}\n";
+    GLint ok=0;char log[512];
+    GLuint v=glCreateShader(GL_VERTEX_SHADER),f=glCreateShader(GL_FRAGMENT_SHADER);
+    glShaderSource(v,1,&vs,NULL);glCompileShader(v);glGetShaderiv(v,GL_COMPILE_STATUS,&ok);
+    if(!ok){log[0]=0;glGetShaderInfoLog(v,sizeof log,NULL,log);diag_printf("WOL_RBLIT_REALIZE stage=vertex ok=0 log=%s\n",log);return 0;}
+    glShaderSource(f,1,&fs,NULL);glCompileShader(f);glGetShaderiv(f,GL_COMPILE_STATUS,&ok);
+    if(!ok){log[0]=0;glGetShaderInfoLog(f,sizeof log,NULL,log);diag_printf("WOL_RBLIT_REALIZE stage=fragment ok=0 log=%s\n",log);return 0;}
+    GLuint pr=glCreateProgram();glAttachShader(pr,v);glAttachShader(pr,f);
+    glBindAttribLocation(pr,0,"p");glBindAttribLocation(pr,1,"t");glLinkProgram(pr);glGetProgramiv(pr,GL_LINK_STATUS,&ok);
+    if(!ok){log[0]=0;glGetProgramInfoLog(pr,sizeof log,NULL,log);diag_printf("WOL_RBLIT_REALIZE stage=link ok=0 log=%s\n",log);return 0;}
+    wol_rblit_program=pr;wol_rblit_tex=glGetUniformLocation(pr,"tex");
+    diag_printf("WOL_RBLIT_REALIZE ok=1 program=%u tex=%d\n",(unsigned)pr,(int)wol_rblit_tex);
