+#ifndef WOL_COPY_EQUAL_H
+#define WOL_COPY_EQUAL_H
+/* Bounded exact successive destination snapshot census, NOT an upload skip.
+ * Result: 0 first/new identity, 1 byte-exact equal, 2 changed, 3 unavailable.
+ * No hash-only equivalence, source-GPU alias, or host-validity assumption. */
+#define WOL_COPY_EQUAL_LIMIT (4U*1024U*1024U)
+struct wol_copy_equal_key {
+    uint64_t object,id,pool,address,bytes,name,context;
+};
+struct wol_copy_equal_state {
+    struct wol_copy_equal_key key;
+    uint8_t *snapshot;
+    size_t capacity;
+    unsigned valid;
+};
+static unsigned wol_copy_equal_observe(struct wol_copy_equal_state *s,
+        const struct wol_copy_equal_key *key,const void *bytes) {
+    if(!s || !key || !bytes || !key->bytes || key->bytes>WOL_COPY_EQUAL_LIMIT)return 3;
+    size_t n=(size_t)key->bytes;
+    if(n>s->capacity) {
+        uint8_t *p=realloc(s->snapshot,n);
+        if(!p){s->valid=0;return 3;}
+        s->snapshot=p;s->capacity=n;s->valid=0;
+    }
+    unsigned same=s->valid && !memcmp(&s->key,key,sizeof(*key));
+    unsigned result=same?(memcmp(s->snapshot,bytes,n)?2:1):0;
+    if(result!=1)memcpy(s->snapshot,bytes,n);
+    s->key=*key;s->valid=1;
+    return result;
+}
+#endif
