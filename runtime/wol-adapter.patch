+/* Exact last-successful-upload bytes, scoped to one bounded host image.
+ * A prepared CPU snapshot is not valid GPU content until successful commit.
+ * Every non-refresh host writer must invalidate overlapping storage first. */
+struct wol_upload_guard {
+    struct wol_copy_equal_state copy;
+    unsigned host_valid;
+};
+static unsigned wol_upload_guard_prepare(struct wol_upload_guard *s,
+        const struct wol_copy_equal_key *key,const void *bytes) {
+    unsigned equal=wol_copy_equal_observe(&s->copy,key,bytes)==1;
+    unsigned skip=equal && s->host_valid;
+    if(!skip)s->host_valid=0;
+    return skip;
+}
+static void wol_upload_guard_commit(struct wol_upload_guard *s,
+        const struct wol_copy_equal_key *key,unsigned error) {
+    s->host_valid=!error && s->copy.valid && !memcmp(&s->copy.key,key,sizeof(*key));
+}
