+    static const char *fs="precision mediump float;varying vec2 uv;uniform sampler2D tex;void main(){gl_FragColor=texture2D(tex,uv);}\n";
+    GLint ok=0;char log[512];
+    GLuint v=glCreateShader(GL_VERTEX_SHADER),f=glCreateShader(GL_FRAGMENT_SHADER);
+    glShaderSource(v,1,&vs,NULL);glCompileShader(v);glGetShaderiv(v,GL_COMPILE_STATUS,&ok);
+    if(!ok){log[0]=0;glGetShaderInfoLog(v,sizeof log,NULL,log);diag_printf("WOL_BLIT_REALIZE stage=vertex ok=0 log=%s\n",log);return 0;}
+    glShaderSource(f,1,&fs,NULL);glCompileShader(f);glGetShaderiv(f,GL_COMPILE_STATUS,&ok);
+    if(!ok){log[0]=0;glGetShaderInfoLog(f,sizeof log,NULL,log);diag_printf("WOL_BLIT_REALIZE stage=fragment ok=0 log=%s\n",log);return 0;}
