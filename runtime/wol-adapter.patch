+ * Keep a corrupt/partial existing identity intact and fail closed, rather than
+ * silently changing a title's identity. The caller holds the IPC kernel lock. */
+static int wol_profile_device_id(int directory,uint64_t program_id,uint8_t out[16]) {
+    char name[64];uint8_t identity[16];
