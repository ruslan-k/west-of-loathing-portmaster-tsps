+/* The guest color contract for one substituted draw: blend enable (bit 0x100 of the NVN color
+ * word), separate rgb/alpha factors and equations, and the colour write mask. Measured on the
+ * device: the sprite passes request SRC_ALPHA/ONE_MINUS_SRC_ALPHA, and a transparent fullscreen
+ * sprite (vertex colour 0,0,0,0) must be a no-op - with the state unapplied it wiped the target
+ * black (sprite scan 586 -> 0). Direct GL calls, never a cache-gated skip: the present/upload
+ * paths toggle GL_BLEND behind the state cache's back, so a cache-based send wrongly skips the
+ * re-enable (run 167: gl-blend=0 at draw time for thousands of draws). The four touched cache
+ * slots are invalidated so the next cache user always re-syncs with GL. Defined here, outside
+ * every game-conditional block, because the WoL pair path calls it too. */
+static void wol_apply_color_state(uint32_t guest_flags, uint32_t blend, uint32_t equation, uint32_t mask) {
+    unsigned sf=blend&127,df=(blend>>8)&127,af=(blend>>16)&127,da=(blend>>24)&127;
+    unsigned ce=(equation>>24)&7,ae=(equation>>28)&7;
+    nvn_render_state_epoch();
+    if(guest_flags&0x100u) {
+        glEnable(GL_BLEND);
+        glBlendFuncSeparate(nvn_blend_factor(sf),nvn_blend_factor(df),nvn_blend_factor(af),nvn_blend_factor(da));
+        glBlendEquationSeparate(nvn_blend_equation(ce),nvn_blend_equation(ae));
+    } else glDisable(GL_BLEND);
+    nvn_render_color_mask(mask&15U);
+    nvn_render_state.valid&=~((1u<<NCS_BLEND_ENABLE)|(1u<<NCS_BLEND_FUNC)|(1u<<NCS_BLEND_EQUATION)|(1u<<NCS_COLOR_MASK));
