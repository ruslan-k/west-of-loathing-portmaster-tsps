+static unsigned wol_up24_read(uint64_t owner, uint64_t field, uint32_t *out) {
+    if(owner > UINT64_MAX - 128 || wol_up24_mem < 0) return 0;
+    if(!accessible(owner + field, 4, PROT_READ)) return 0;
+    return pread(wol_up24_mem, out, 4, (off_t)(owner + field)) == 4;
