diff --git a/runtime/host/test/test_audio_wiring.py b/runtime/host/test/test_audio_wiring.py
new file mode 100644
--- /dev/null
+++ b/runtime/host/test/test_audio_wiring.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""The legacy Java FMOD path must have a real sink in the shipped host."""
+from pathlib import Path
+import unittest
+
+HOST = Path(__file__).resolve().parents[1]
+
+class AudioWiring(unittest.TestCase):
+    def test_host_connects_legacy_fmod_before_start(self):
+        source = (HOST / 'ua_host.c').read_text()
+        self.assertTrue('cfg.on_audio = legacy_audio_write;' in source,
+                        'legacy FMOD PCM is discarded because no output callback is connected')
+        self.assertLess(source.index('cfg.on_audio = legacy_audio_write;'), source.index('up_start(&cfg)'))
+
+    def test_audio_closes_only_after_fmod_thread_stops(self):
+        source = (HOST / 'ua_host.c').read_text()
+        self.assertIn('legacy_audio_close();', source)
+        self.assertLess(source.index('up_wait();'), source.index('legacy_audio_close();'))
+
+    def test_both_architectures_link_sink(self):
+        source = (HOST / 'build.sh').read_text()
+        self.assertIn('ua_host legacy_audio input', source)
+        self.assertIn('-c legacy_audio.c -o out/legacy_audio.o', source)
+        self.assertIn('out/ua_host.o out/legacy_audio.o', source)
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/runtime/host/test/test_legacy_audio.c b/runtime/host/test/test_legacy_audio.c
new file mode 100644
--- /dev/null
+++ b/runtime/host/test/test_legacy_audio.c
@@ -0,0 +1,69 @@
+// Real SDL queue tests (dummy backend); the silent mode opens the target PCM without game or tone.
+#include "../legacy_audio.c"
+#include <assert.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+    int16_t pcm[512] = {0};
+    if (argc > 1 && !strcmp(argv[1], "silent")) {
+        for (int i = 0; i < 94; i++) legacy_audio_write(NULL, pcm, 256, 24000);
+        assert(g_device != 0 && !g_failed && g_frames == 94 * 256 && g_nonzero_blocks == 0);
+        SDL_Delay(80);
+        assert(SDL_GetQueuedAudioSize(g_device) == 0);
+        legacy_audio_close();
+        assert(SDL_WasInit(SDL_INIT_AUDIO) == 0);
+        puts("PASS target silent PCM drained and closed");
+        return 0;
+    }
+    SDL_setenv("SDL_AUDIODRIVER", "dummy", 1);
+    legacy_audio_write(NULL, NULL, 256, 24000);
+    legacy_audio_write(NULL, pcm, -1, 24000);
+    legacy_audio_write(NULL, pcm, 256, 0);
+    assert(g_device == 0 && g_frames == 0);
+    puts("PASS invalid input does not initialize output");
+    for (int i = 0; i < 512; i++) pcm[i] = (int16_t)(i - 256);
+    Uint32 start = SDL_GetTicks();
+    for (int i = 0; i < 20; i++) legacy_audio_write(NULL, pcm, 256, 24000);
+    assert(g_device != 0 && g_rate == 24000 && !g_failed);
+    assert(g_frames == 20 * 256 && g_nonzero_blocks == 20);
+    assert(SDL_GetTicks() - start >= 100);
+    assert(SDL_GetQueuedAudioSize(g_device) <= 4 * sizeof pcm);
+    puts("PASS real SDL queue receives PCM with bounded backlog and pacing");
+    SDL_Delay(80);
+    assert(SDL_GetQueuedAudioSize(g_device) == 0);
+    puts("PASS queued PCM drains");
+    legacy_audio_write(NULL, pcm, 256, 48000);
+    assert(g_device != 0 && g_rate == 48000 && !g_failed);
+    puts("PASS rate change reopens output");
+    legacy_audio_close();
+    assert(g_device == 0 && SDL_WasInit(SDL_INIT_AUDIO) == 0);
+    puts("PASS close releases SDL audio ownership");
+    legacy_audio_close();
+    puts("PASS repeated close is safe");
+    SDL_setenv("SDL_AUDIODRIVER", "not-a-real-driver", 1);
+    start = SDL_GetTicks();
+    for (int i = 0; i < 6; i++) legacy_audio_write(NULL, pcm, 256, 24000);
+    assert(g_failed && g_device == 0 && SDL_GetTicks() - start >= 50);
+    puts("PASS failed output is paced instead of busy-spinning");
+    legacy_audio_close();
+    SDL_setenv("SDL_AUDIODRIVER", "dummy", 1);
+    legacy_audio_write(NULL, pcm, 256, 24000);
+    assert(g_device != 0 && !g_failed);
+    legacy_audio_close();
+    puts("PASS fresh lifecycle can recover after failure");
+    legacy_audio_write(NULL, pcm, 256, 24000);
+    SDL_PauseAudioDevice(g_device, 1);
+    start = SDL_GetTicks();
+    for (int i = 0; i < 6; i++) legacy_audio_write(NULL, pcm, 256, 24000);
+    assert(g_failed && g_device == 0 && SDL_GetTicks() - start < 1000);
+    puts("PASS stalled output has a bounded wait and releases its device");
+    legacy_audio_close();
+    legacy_audio_write(NULL, pcm, 256, 24000);
+    SDL_CloseAudioDevice(g_device);
+    legacy_audio_write(NULL, pcm, 256, 24000);
+    assert(g_failed && g_device == 0);
+    puts("PASS SDL queue error disables output safely");
+    legacy_audio_close();
+    return 0;
+}
