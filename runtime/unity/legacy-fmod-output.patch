diff --git a/runtime/host/legacy_audio.c b/runtime/host/legacy_audio.c
new file mode 100644
--- /dev/null
+++ b/runtime/host/legacy_audio.c
@@ -0,0 +1,80 @@
+// The Java FMOD/AudioTrack path is separate from OpenSL ES and needs its own host sink.
+#include "legacy_audio.h"
+#include <SDL2/SDL.h>
+#include <stdio.h>
+
+static SDL_AudioDeviceID g_device;
+static int g_rate, g_acquired, g_failed;
+static Uint32 g_report;
+static uint64_t g_frames, g_nonzero_blocks;
+
+void legacy_audio_close(void)
+{
+    if (g_device) SDL_CloseAudioDevice(g_device);
+    if (g_frames) fprintf(stderr, "[audio] legacy FMOD closed: frames=%llu nonzero-blocks=%llu\n",
+                         (unsigned long long)g_frames, (unsigned long long)g_nonzero_blocks);
+    if (g_acquired) SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    g_device = 0;
+    g_rate = g_acquired = g_failed = 0;
+    g_frames = g_nonzero_blocks = 0;
+}
+
+void legacy_audio_write(void *user, const int16_t *pcm, int frames, int rate)
+{
+    (void)user;
+    if (!pcm || rate < 8000 || rate > 192000 || frames <= 0 || frames > rate) return;
+    Uint32 bytes = (Uint32)frames * 2 * sizeof *pcm;
+    if (g_device && g_rate != rate) { SDL_CloseAudioDevice(g_device); g_device = 0; }
+    if (!g_device && !g_failed) {
+        if (!g_acquired) {
+            if (SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) g_failed = 1;
+            else g_acquired = 1;
+        }
+        if (!g_failed) {
+            SDL_AudioSpec want = {0}, have;
+            want.freq = rate;
+            want.format = AUDIO_S16SYS;
+            want.channels = 2;
+            want.samples = 512;
+            g_device = SDL_OpenAudioDevice(NULL, 0, &want, &have, 0);
+            if (!g_device) g_failed = 1;
+            else {
+                g_rate = rate;
+                g_report = SDL_GetTicks();
+                fprintf(stderr, "[audio] legacy FMOD -> SDL %s: %d Hz, stereo s16, %u frames\n",
+                        SDL_GetCurrentAudioDriver(), have.freq, have.samples);
+                SDL_PauseAudioDevice(g_device, 0);
+            }
+        }
+        if (g_failed) fprintf(stderr, "[audio] legacy FMOD output failed: %s\n", SDL_GetError());
+    }
+    if (!g_failed) {
+        Uint32 start = SDL_GetTicks();
+        // Block like AudioTrack.write; bound both queued audio and waits on a stalled device.
+        while (SDL_GetQueuedAudioSize(g_device) > bytes * 3) {
+            if (SDL_GetTicks() - start >= 500) {
+                fprintf(stderr, "[audio] legacy FMOD output stalled; disabling the sink\n");
+                g_failed = 1;
+                break;
+            }
+            SDL_Delay(1);
+        }
+        if (!g_failed && SDL_QueueAudio(g_device, pcm, bytes) != 0) {
+            fprintf(stderr, "[audio] legacy FMOD queue failed: %s\n", SDL_GetError());
+            g_failed = 1;
+        }
+    }
+    if (g_failed) {
+        if (g_device) { SDL_CloseAudioDevice(g_device); g_device = 0; }
+        SDL_Delay((Uint32)frames * 1000 / rate + 1);
+        return;
+    }
+    g_frames += frames;
+    for (int i = 0; i < frames * 2; i++) if (pcm[i]) { g_nonzero_blocks++; break; }
+    if (SDL_GetTicks() - g_report >= 5000) {
+        fprintf(stderr, "[audio] legacy FMOD: frames=%llu nonzero-blocks=%llu queued=%u\n",
+                (unsigned long long)g_frames, (unsigned long long)g_nonzero_blocks,
+                SDL_GetQueuedAudioSize(g_device));
+        g_report = SDL_GetTicks();
+    }
+}
